       } catch (PDOException $e) {\n            // 本番環境ではログに残すだけにし、画面には出さない\n            error_log('[DB CONNECT ERROR] '.$e->getMessage());\n            http_response_code(500);\n            exit('データベースに接続できません。');\n        }\n    }\n    return $pdo;\n}\n\n// ---------- 3. セッション開始 ----------\nsession_start();\n\n// ---------- 4. エラーハンドリング ----------\nset_error_handler(function ($severity, $msg, $file, $line) {\n    if ($severity === E_WARNING || $severity === E_NOTICE) {\n        trigger_error($msg, $severity);\n        return false;\n    }\n    throw new ErrorException($msg, 0, $severity, $file, $line);\n});\n```\n\n*ポイント*  \n- **PDO の例外モード**でエラー処理が楽になる。  \n- `charset=utf8mb4` を忘れずに。  \n- `session_start()` は **全ファイルの先頭**で呼び出すこと。\n\n---\n\n## 5️⃣ `functions.php` – 共通ユーティリティ\n\n```php\n<?php\n// app/functions.php\ndeclare(strict_types=1);\n\nuse PDO;\nuse PDOStatement;\n\n// -------------------------------------------------\n// 1. パスワードハッシュ／検証\n// -------------------------------------------------\nfunction hashPassword(string $raw): string\n{\n    return password_hash($raw, PASSWORD_DEFAULT);\n}\nfunction verifyPassword(string $raw, string $hash): bool\n{\n    return password_verify($raw, $hash);\n}\n\n// -------------------------------------------------\n// 2. CSRF トークン生成・検証\n// -------------------------------------------------\nfunction csrfToken(): string\n{\n    if (empty($_SESSION['_csrf'])) {\n        $_SESSION['_csrf'] = bin2hex(random_bytes(32));\n    }\n    return $_SESSION['_csrf'];\n}\nfunction verifyCsrf(string $token): bool\n{\n    return hash_equals($_SESSION['_csrf'] ?? '', $token);\n}\n\n// -------------------------------------------------\n// 3. バリデーションヘルパー\n// -------------------------------------------------\nfunction required(array $data, string $key, string $msg = 'この項目は必須です'): bool\n{\n    return isset($data[$key]) && !empty(trim($data[$key]));\n}\nfunction emailValid(array $data, string $key, string $msg = 'メールアドレスが不正です'): bool\n{\n    $val = 